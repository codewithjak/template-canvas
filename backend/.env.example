# Copy to backend/.env (gitignored) for local dev, or set these as
# environment variables in your deploy (App Runner, etc.).

# Origin allowed by CORS (the deployed/local frontend URL).
FRONTEND_ORIGIN=http://localhost:5173

# Server-side usage tracking (tamper-proof export logging).
# SUPABASE_URL is the BASE project URL — NO trailing /rest/v1.
# The service-role key bypasses RLS, so keep it secret and never commit it.
# If either is missing, export tracking quietly no-ops.
SUPABASE_URL=https://jbdybsmieotaqovfklrw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Contact form (POST /contact). SendGrid API key with "Mail Send" permission.
# CONTACT_FROM must be a SendGrid-authenticated sender/domain (noreply@map-doc.com).
# CONTACT_TO defaults to junaid.khan@map-doc.com (forwards to the team inbox).
# If SENDGRID_API_KEY is missing, the endpoint returns 503.
SENDGRID_API_KEY=
CONTACT_FROM=noreply@map-doc.com
CONTACT_TO=junaid.khan@map-doc.com

# DEV ONLY — enables POST /v1/plan so a signed-in user can switch their own
# team's plan (stand-in for Stripe checkout while billing isn't wired). Leave
# UNSET in production: the endpoint returns 403 and only the billing webhook
# may write teams.plan. Set to the string "true" to enable.
ALLOW_PLAN_SELF_SERVICE=true

# Platform admins (comma-separated) — gates the admin panel / requireAdmin middleware.
ADMIN_EMAILS=you@example.com
